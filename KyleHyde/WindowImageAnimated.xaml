<Window
    x:Class="KyleHyde.WindowImageAnimated"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WindowImageAnimated"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Border x:Name="brdImage">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                <Button
                    x:Name="btnSaveFrames"
                    Margin="0,0,5,0"
                    Padding="5,5,5,5"
                    HorizontalAlignment="Left"
                    Click="btnSaveFrames_Click"
                    Content="Save Frames" />
                <Button
                    x:Name="btnImagePlayPause"
                    Margin="0,0,5,0"
                    Padding="5,5,5,5"
                    Click="btnImagePlayPause_Click"
                    Content="Play/Pause" />
                <Button
                    x:Name="btnImageSpeed50"
                    Margin="0,0,5,0"
                    Padding="5,5,5,5"
                    Click="btnImageSpeed50_Click"
                    Content="Speed 50" />
                <Button
                    x:Name="btnImageSpeed100"
                    Margin="0,0,5,0"
                    Padding="5,5,5,5"
                    Click="btnImageSpeed100_Click"
                    Content="100" />
                <Button
                    x:Name="btnImageSpeed150"
                    Margin="0,0,5,0"
                    Padding="5,5,5,5"
                    Click="btnImageSpeed150_Click"
                    Content="150" />
                <Button
                    x:Name="btnImageBgLight"
                    Margin="0,0,5,0"
                    Padding="5,5,5,5"
                    Click="btnImageBgLight_Click"
                    Content="BG Light" />
                <Button
                    x:Name="btnImageBgDark"
                    Padding="5,5,5,5"
                    Click="btnImageBgDark_Click"
                    Content="Dark" />
            </StackPanel>
            <Image
                x:Name="imageBox"
                Grid.Row="1"
                Stretch="None"
                StretchDirection="DownOnly" />
        </Grid>
    </Border>
</Window>